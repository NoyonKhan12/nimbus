#!/usr/bin/env bash
# Nimbus Passenger App compose helper
#
# Usage:
#   ./compose up            # Build and run APK builder (dev)
#   ./compose up -d         # Background build
#   ./compose down          # Clean up
#   APP_ENV=local ./compose up
#   APP_ENV=prod ./compose up   # Production APK build

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Save externally-provided APP_ENV
EXTERNAL_APP_ENV="${APP_ENV:-}"

# Load .env if it exists
if [[ -f ".env" ]]; then
    set -o allexport
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            if [[ "$line" =~ ^APP_ENV= ]] && [[ -n "$EXTERNAL_APP_ENV" ]]; then
                continue
            fi
            export "$line"
        fi
    done < .env
    set +o allexport
fi

APP_ENV="${APP_ENV:-local}"

case "$APP_ENV" in
    local|dev)
        COMPOSE_FILE="docker-compose.yml"
        ;;
    prod)
        COMPOSE_FILE="docker-compose.prod.yml"
        ;;
    *)
        echo "Error: Unknown APP_ENV '$APP_ENV'. Valid values: local, dev, prod" >&2
        exit 1
        ;;
esac

echo "Nimbus App - Using APP_ENV=$APP_ENV -> $COMPOSE_FILE"
exec docker compose -f "$COMPOSE_FILE" "$@"
