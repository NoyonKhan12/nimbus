# Nimbus Environment Configuration
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Set the active environment: local, dev, or prod
APP_ENV=local

# Spring profile (should match APP_ENV)
SPRING_PROFILES_ACTIVE=local

# --- Database (local) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/nimbus
DATABASE_USERNAME=nimbus
DATABASE_PASSWORD=nimbus_password

# --- Redis (local) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App ---
JWT_SECRET=bmltYnVzLWRldi1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9u
APP_PORT=9090
ADMIN_PORT=3000
LOG_LEVEL_NIMBUS=INFO
LOG_LEVEL_ROOT=INFO

# --- Prod-only (override these for production) ---
# POSTGRES_DB=nimbus_prod
# POSTGRES_PASSWORD=your-prod-password-here
# REDIS_PASSWORD=your-redis-password-here
