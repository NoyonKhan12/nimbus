# Nimbus API - Production Environment
# All secrets must be provided externally at runtime.

APP_ENV=prod
SPRING_PROFILES_ACTIVE=prod

# Database
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/nimbus_prod
JDBC_DATABASE_USERNAME=nimbus
# POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=changeme

# JWT - MUST be provided externally
# JWT_SECRET=changeme

JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=2592000000

# App
APP_PORT=8080
LOG_LEVEL_NIMBUS=INFO
LOG_LEVEL_ROOT=INFO
